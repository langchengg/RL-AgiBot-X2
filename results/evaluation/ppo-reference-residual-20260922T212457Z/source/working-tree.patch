+BILATERAL_ACTION_NAMES = ('hip_pitch', 'hip_roll', 'hip_yaw', 'knee', 'ankle_pitch',
+                          'ankle_roll', 'waist_pitch', 'shoulder_pitch', 'shoulder_roll',
+                          'shoulder_yaw', 'elbow')
