+        stats['peak_ground_vertical_N'] = max(stats['peak_ground_vertical_N'], contacts['ground_vertical_N'])
+        stats['peak_ground_sum_norm_N'] = max(stats['peak_ground_sum_norm_N'], contacts['ground_sum_norm_N'])
