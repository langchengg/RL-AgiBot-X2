+def torso_ankle_feedback_action(observation, control, q_min, q_max,
+                                joint_velocity_scale=5., base_angular_scale=2., timeout_s=20.):
+    """Memoryless149D torso feedback, preserving the measured float32 action path.
+
+    The constant law adds equal ankle pitch offsets. It is an explicit reference
+    controller component, independent of learned PPO actions and residual scale.
+    """
+    require(control.version == 'targets-v6', 'Torso feedback requires targets-v6')
+    obs = np.asarray(observation, dtype=float)
+    require(obs.shape == (149,) and np.isfinite(obs).all(), 'Expected finite149D feedback observation')
+    action = np.zeros(17, dtype=np.float32)
+    if (control.feedback_kp == 0 and control.feedback_kd == 0) or obs[148]*timeout_s < control.feedback_start_s:
+        return action
+    lower, upper = np.asarray(q_min, dtype=float), np.asarray(q_max, dtype=float)
+    require(lower.shape == upper.shape == (31,) and np.all(lower < upper), 'Invalid feedback joint bounds')
+    q = (lower+upper)/2+obs[:31]*(upper-lower)/2
+    yaw, pitch, roll = q[[12, 13, 14]]
+    sy, cy = np.sin(yaw), np.cos(yaw)
+    sp, cp = np.sin(pitch), np.cos(pitch)
+    sr, cr = np.sin(roll), np.cos(roll)
+    Z = np.array([[cy, -sy, 0.], [sy, cy, 0.], [0., 0., 1.]])
+    Y = np.array([[cp, 0., sp], [0., 1., 0.], [-sp, 0., cp]])
+    X = np.array([[1., 0., 0.], [0., cr, -sr], [0., sr, cr]])
+    Q = Z@Y@X
+    axes = np.column_stack([np.array([0., 0., 1.]), Z@np.array([0., 1., 0.]), Z@Y@np.array([1., 0., 0.])])
+    gravity = Q.T@obs[62:65]
+    waist_velocity = (obs[31:62]*joint_velocity_scale)[[12, 13, 14]]
+    omega = Q.T@(obs[68:71]*base_angular_scale+axes@waist_velocity)
+    gravity_rate = -np.cross(omega, gravity)
+    x, _, z = gravity
+    dx, _, dz = gravity_rate
+    denominator = x*x+z*z
+    require(denominator > 1e-10, 'Sagittal gravity projection is undefined')
+    tilt = float(np.arctan2(x, -z))
+    rate = float((-z*dx+x*dz)/denominator)
+    delta = float(np.clip(control.feedback_kp*tilt+control.feedback_kd*rate,
+                         -control.feedback_cap_rad, control.feedback_cap_rad))
+    action[[4, 10]] = delta/control.feedback_cap_rad
+    return action
+
+
+def feedback_phase_gate(control, elapsed_sim_s):
+    require(control.version == 'targets-v6' and np.isfinite(elapsed_sim_s) and elapsed_sim_s >= 0,
+            'Invalid feedback phase')
+    u = float(np.clip((elapsed_sim_s-control.feedback_start_s)/control.feedback_ramp_s, 0., 1.))
+    return u**3*(10.-15.*u+6.*u*u)
