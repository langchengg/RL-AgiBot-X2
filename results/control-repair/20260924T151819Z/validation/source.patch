+        stats['any_tolerance_s'] += float(np.any(ex > CALIBRATED_SETTINGS.joint_limit_rad_max))*dt
+        if stats['first_violation_s'] is None and np.any(ex > CALIBRATED_SETTINGS.joint_limit_rad_max):
