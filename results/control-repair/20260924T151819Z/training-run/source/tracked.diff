+def feedback_phase_gate(control, elapsed_sim_s):
+    require(control.version == 'targets-v6' and np.isfinite(elapsed_sim_s) and elapsed_sim_s >= 0,
+            'Invalid feedback phase')
+    u = float(np.clip((elapsed_sim_s-control.feedback_start_s)/control.feedback_ramp_s, 0., 1.))
+    return u**3*(10.-15.*u+6.*u*u)
+
